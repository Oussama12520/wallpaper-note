<Window x:Class="NoteWall.QuickNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoteWall Quick Note" 
        Height="140" Width="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">
    <Border Background="#18181B" 
            BorderBrush="#3F3F46" 
            BorderThickness="1" 
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.55"/>
        </Border.Effect>
        <Grid Margin="18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border Width="8" Height="8" CornerRadius="4" Background="#6366F1" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="QUICK NOTE" Foreground="#A1A1AA" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Text=" — Press Enter to add" Foreground="#71717A" FontSize="11" Margin="6,0,0,0"/>
            </StackPanel>

            <!-- Text input -->
            <TextBox x:Name="NoteInput" Grid.Row="1" 
                     Margin="0,8,0,8" 
                     Background="#27272A" 
                     Foreground="#F4F4F5" 
                     CaretBrush="#818CF8"
                     BorderThickness="1" 
                     BorderBrush="#3F3F46" 
                     FontSize="14" 
                     FontFamily="Segoe UI"
                     Padding="10,6" 
                     KeyDown="NoteInput_KeyDown"
                     VerticalContentAlignment="Center">
                <TextBox.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <!-- Footer / hints -->
            <DockPanel Grid.Row="2">
                <TextBlock Text="Ctrl+Shift+N" Foreground="#52525B" FontSize="10" VerticalAlignment="Center"/>
                <Button Content="Esc to cancel" Click="Cancel_Click" DockPanel.Dock="Right" 
                        Background="Transparent" Foreground="#71717A" BorderThickness="0" 
                        FontSize="11" Cursor="Hand" HorizontalAlignment="Right"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
